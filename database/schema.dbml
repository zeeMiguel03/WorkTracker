Table User {
  Id int [pk, increment]
  Name varchar(150) [not null]
  Email varchar(255) [not null, unique]
  PasswordHash varchar(500) [not null]
  ProfileImageUrl varchar(500)
  CreatedAt datetime [not null]
}

Table Source {
  Id int [pk, increment]
  UserId int [not null]
  Name varchar(150) [not null]
  ImageUrl varchar(500)
  CreatedAt datetime [not null]
  IsActive boolean [not null, default: true]
}

Table Entry {
  Id int [pk, increment]
  SourceId int [not null]
  TransactionTypeId int [not null]
  AccountId int [not null]
  Name varchar(150) [not null]
  ImageUrl varchar(500)
  Description varchar(500)
  Quantity decimal(10,2) [not null, default: 1]
  Value decimal(10,2) [not null]
  Date datetime [not null]
  CreatedAt datetime [not null]
}

Table TransactionType {
  Id int [pk, increment]
  UserId int [not null]
  Name varchar(150) [not null]
  Color varchar(150) [not null]

  indexes {
    (UserId, Name) [unique]
  }
}

Table Account {
  Id int [pk, increment]
  UserId int [not null]
  AccountTypeId int [not null]
  Name varchar(150) [not null]
  BankName varchar(150)
  CardBrand varchar(50)
  Last4 varchar(4)
  ImageUrl varchar(500)
  Color varchar(50)
  CreatedAt datetime [not null]
}

Table AccountType {
  Id int [pk, increment]
  Name varchar(100) [not null]
}

Table Task {
  Id int [pk, increment]
  UserId int [not null]
  SourceId int
  TaskStatusId int [not null]
  Title varchar(150) [not null]
  Description varchar(500)
  Priority int [not null, default: 1]
  SortOrder int [not null, default: 0]
  DueDate datetime
  CompletedAt datetime
  CreatedAt datetime [not null]
}

Table TaskStatus {
  Id int [pk, increment]
  UserId int [not null]
  Name varchar(100) [not null]
  Color varchar(50) [not null]
  SortOrder int [not null]
}

/* RELATIONSHIPS */

Ref: Source.UserId > User.Id

Ref: Entry.SourceId > Source.Id
Ref: Entry.TransactionTypeId > TransactionType.Id
Ref: TransactionType.UserId > User.Id
Ref: Entry.AccountId > Account.Id

Ref: Account.UserId > User.Id
Ref: Account.AccountTypeId > AccountType.Id

Ref: Task.UserId > User.Id
Ref: Task.SourceId > Source.Id
Ref: Task.TaskStatusId > TaskStatus.Id

Ref: TaskStatus.UserId > User.Id
